# Copy to .env.local and fill as needed.

# Google SSO (for local test with same flow as prod). Add http://tinyauth.lvh.me to your Google OAuth client redirect URIs.
# TINYAUTH_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# TINYAUTH_GOOGLE_CLIENT_SECRET=xxx

# Optional: local Tinyauth user (fallback or no Google). Generate: docker run -it --rm ghcr.io/steveiliop56/tinyauth:v4 user create --interactive
# TINYAUTH_USERS=user:$$2a$$10$$...
